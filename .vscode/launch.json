{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Evolution: mostrar URL e chave",
      "command": "bash infra/evolution/codespace/show-config.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Evolution: atualizar e reiniciar QA",
      "command": "git pull --ff-only && bash infra/evolution/codespace/start.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Evolution: abrir chave para copiar",
      "command": "bash -lc 'set -a; source \"$HOME/.comandiva-evolution-qa/runtime.env\"; set +a; printf \"%s\" \"$EVOLUTION_API_KEY\" > /tmp/comandiva-evolution-api-key.txt; code /tmp/comandiva-evolution-api-key.txt'",
      "cwd": "${workspaceFolder}"
    }
  ]
}
