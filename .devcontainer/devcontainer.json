{
  "name": "Comandiva · Evolution QA",
  "image": "mcr.microsoft.com/devcontainers/universal:6.1-linux",
  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": {
      "label": "Evolution API QA",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Evolution QA config · PRIVATE",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash infra/evolution/codespace/start.sh"
}
