# Supabase production foundation
# Expected project ref: ypgteuxzgqmkkkpvibhi

# Browser-safe only. Privileged operations run inside Supabase Edge Functions;
# the Lovable runtime must not receive SUPABASE_SERVICE_ROLE_KEY or sb_secret_*.
VITE_SUPABASE_URL=https://ypgteuxzgqmkkkpvibhi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe public browser credential only when a browser integration needs it.
# STRIPE_SECRET_KEY and webhook signing secrets belong only in Supabase Edge Function secrets.
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Business Profile OAuth — SERVER-SIDE / Supabase Edge Function secrets only.
# Do not prefix these with VITE_ and do not expose them to the Lovable/browser runtime.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=https://ypgteuxzgqmkkkpvibhi.supabase.co/functions/v1/comandiva-google-business
GOOGLE_BUSINESS_APP_RETURN_URL=https://YOUR_APP_DOMAIN/app/loja/google-business

# Environment gates
APP_ENV=development
