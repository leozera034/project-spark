:8080 {
  header X-Comandiva-Gateway "jwt-v1"

  @health path /
  handle @health {
    reverse_proxy evolution:8080 {
      header_up apikey {$EVOLUTION_API_KEY}
    }
  }

  @local header apikey {$EVOLUTION_API_KEY}
  handle @local {
    reverse_proxy evolution:8080 {
      header_up apikey {$EVOLUTION_API_KEY}
    }
  }

  handle {
    forward_auth https://ypgteuxzgqmkkkpvibhi.supabase.co {
      uri /functions/v1/comandiva-evolution-gateway-auth
      header_up Authorization {http.request.header.Authorization}
      header_up X-Comandiva-Store-Id {http.request.header.X-Comandiva-Store-Id}
      header_up X-Legacy-Evolution-Key {http.request.header.apikey}
    }

    reverse_proxy evolution:8080 {
      header_up apikey {$EVOLUTION_API_KEY}
    }
  }
}
