:8080 {
  header X-Comandiva-Gateway "basic-v2"

  @gateway_diag path /__comandiva_gateway
  handle @gateway_diag {
    respond "basic-v2" 200
  }

  @health path /
  handle @health {
    respond "basic-v2" 200
  }

  @local header apikey {$EVOLUTION_API_KEY}
  handle @local {
    reverse_proxy evolution:8080 {
      header_up apikey {$EVOLUTION_API_KEY}
    }
  }

  @auth_diag path /__comandiva_auth
  handle @auth_diag {
    basic_auth {
      comandiva {$CADDY_BASIC_AUTH_HASH}
    }
    respond "authorized" 200
  }

  @upstream_diag path /__comandiva_upstream
  handle @upstream_diag {
    basic_auth {
      comandiva {$CADDY_BASIC_AUTH_HASH}
    }
    rewrite * /instance/connectionState/comandiva_security_probe
    reverse_proxy evolution:8080 {
      header_up apikey {$EVOLUTION_API_KEY}
    }
  }

  handle {
    basic_auth {
      comandiva {$CADDY_BASIC_AUTH_HASH}
    }

    reverse_proxy evolution:8080 {
      header_up apikey {$EVOLUTION_API_KEY}
    }
  }
}
